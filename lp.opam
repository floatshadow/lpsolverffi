opam-version: "2.0"
synopsis: "Small OCaml bindings to CLP, HiGHS and GLPK"
maintainer: "Siyuan Zhu"
authors: "Siyuan Zhu"
license: "LGPL-3.0-only"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.15"}
  "dune-configurator" {>= "3.15"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]
